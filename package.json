{
  "name": "nekopoi-api",
  "version": "1.0.0",
  "description": "An unofficial, fully-typed API wrapper for Nekopoi built with TypeScript and Node.js featuring scraping data",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/client.test.ts",
    "demo": "tsx demo.ts"
  },
  "keywords": [
    "nekopoi",
    "api",
    "wrapper",
    "scraper",
    "anime",
    "hentai"
  ],
  "author": "Andhika Dwi Maulana",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andhikadm/nekopoi-api.git"
  },
  "bugs": {
    "url": "https://github.com/andhikadm/nekopoi-api/issues"
  },
  "homepage": "https://github.com/andhikadm/nekopoi-api#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
